#!/usr/bin/env bash

set -euo pipefail

blue=$'\033[1;34m'
green=$'\033[1;32m'
yellow=$'\033[1;33m'
red=$'\033[1;31m'
reset=$'\033[0m'

read_positive_integer() {
    local prompt=$1
    while true; do
        printf '%s%s%s' "$yellow" "$prompt" "$reset"
        if ! read -r REPLY; then
            printf '\n%sInput cancelled.%s\n' "$red" "$reset" >&2
            exit 1
        fi
        if [[ $REPLY =~ ^[1-9][0-9]*$ && ${#REPLY} -le 18 ]]; then
            return
        fi
        printf '%sPlease enter a positive whole number (up to 18 digits).%s\n' "$red" "$reset" >&2
    done
}

printf '%s=== Test File Generator ===%s\n' "$blue" "$reset"
read_positive_integer 'How many files do you want to create? '
file_count=$REPLY

for ((i = 1; i <= file_count; i++)); do
    filename="testfile_$i"
    read_positive_integer "Size of $filename in MiB (1 MiB = 1,048,576 bytes): "
    size=$REPLY

    printf '%sCreating %s (%s MiB)...%s\n' "$blue" "$filename" "$size" "$reset"
    # Refuse to overwrite existing files, including symbolic links.
    if ! (set -o noclobber; dd if=/dev/urandom bs=1048576 count="$size" > "$filename"); then
        printf '%sCould not create %s. Check for an existing file, write permissions, or insufficient disk space.%s\n' "$red" "$filename" "$reset" >&2
        exit 1
    fi
    printf '%sCreated %s successfully.%s\n' "$green" "$filename" "$reset"
done

printf '%sDone! Created %s file(s) in the current directory.%s\n' "$green" "$file_count" "$reset"
