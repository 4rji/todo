#!/usr/bin/env bash

# Controlled HTTP load test for systems you own or are authorized to test.
set -euo pipefail

DEFAULT_RATE=200      # Requests per second (hey uses one worker, so this is total rate)
DEFAULT_DURATION=30   # Seconds
MAX_RATE=500
MAX_DURATION=30
TOOL="c"
PATH_NAME="/zeek-test"

usage() {
    cat >&2 <<'EOF'
Usage: zeek-load-test.sh IP[:PORT] [http|https] [options]

Options:
  --tool c|y|p       c = curl, y = hey, p = httperf (HTTP only)
  --path /PATH       Safe test endpoint (default: /zeek-test)
  --rate NUMBER      Requests per second; maximum 500 (default: 200)
  --duration NUMBER  Test length in seconds; maximum 30 (default: 30)
  -h, --help         Show this help

Examples:
  ./zeek-load-test.sh 192.168.88.10
  ./zeek-load-test.sh 192.168.88.10:8080 http --tool p
  ./zeek-load-test.sh 192.168.88.10 https --tool y --rate 75 --path /zeek-test
EOF
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

[[ $# -ge 1 ]] || { usage; exit 2; }

target=$1
shift
scheme="https"
rate=$DEFAULT_RATE
duration=$DEFAULT_DURATION

if [[ ${1:-} == "http" || ${1:-} == "https" ]]; then
    scheme=$1
    shift
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tool) TOOL=${2:-}; shift 2 ;;
        --path) PATH_NAME=${2:-}; shift 2 ;;
        --rate) rate=${2:-}; shift 2 ;;
        --duration) duration=${2:-}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Error: unknown option: %s\n' "$1" >&2; usage; exit 2 ;;
    esac
done

[[ $TOOL =~ ^(c|y|p)$ ]] || { echo 'Error: --tool must be c, y, or p.' >&2; exit 2; }
[[ $PATH_NAME == /* ]] || { echo 'Error: --path must start with /.' >&2; exit 2; }
[[ $rate =~ ^[0-9]+$ ]] && (( rate >= 1 && rate <= MAX_RATE )) || {
    printf 'Error: --rate must be between 1 and %s.\n' "$MAX_RATE" >&2; exit 2;
}
[[ $duration =~ ^[0-9]+$ ]] && (( duration >= 1 && duration <= MAX_DURATION )) || {
    printf 'Error: --duration must be between 1 and %s.\n' "$MAX_DURATION" >&2; exit 2;
}

if [[ $target =~ ^([0-9.]+)(:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[3]:-}
else
    echo 'Error: target must be an IPv4 address, optionally followed by :PORT.' >&2
    exit 2
fi

IFS=. read -r o1 o2 o3 o4 extra <<< "$host"
[[ -z ${extra:-} && -n ${o4:-} ]] || { echo 'Error: invalid IPv4 address.' >&2; exit 2; }
for octet in "$o1" "$o2" "$o3" "$o4"; do
    [[ $octet =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || {
        echo 'Error: invalid IPv4 address.' >&2; exit 2;
    }
done

if [[ -n $port ]] && { [[ ! $port =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); }; then
    echo 'Error: invalid port.' >&2
    exit 2
fi

base_url="${scheme}://${target}"
url="${base_url}${PATH_NAME}"
requests=$(( rate * duration ))

printf 'Target: %s\n' "$url"
printf 'Controlled load: %s requests/sec for %ss (%s requests maximum)\n' "$rate" "$duration" "$requests"
printf 'Run this only against systems you own or are explicitly authorized to test.\n\n'

case "$TOOL" in
    c)
        command -v curl >/dev/null 2>&1 || { echo 'Error: curl is not installed.' >&2; exit 127; }
        interval=$(awk "BEGIN { printf \"%.3f\", 1 / $rate }")
        for ((i = 1; i <= requests; i++)); do
            curl --silent --show-error --insecure \
                --connect-timeout 5 --max-time 10 \
                --output /dev/null \
                --write-out "Request ${i}: HTTP %{http_code} | %{time_total}s\\n" \
                "$url" || true
            sleep "$interval"
        done
        ;;
    y)
        command -v hey >/dev/null 2>&1 || { echo 'Error: hey is not installed. Install it with: brew install hey' >&2; exit 127; }
        # One worker makes -q an overall rate limit, rather than a per-worker limit.
        hey -q "$rate" -c 1 -z "${duration}s" "$url"
        ;;
    p)
        [[ $scheme == "http" ]] || { echo 'Error: httperf mode supports HTTP only. Use curl or hey for HTTPS.' >&2; exit 2; }
        command -v httperf >/dev/null 2>&1 || { echo 'Error: httperf is not installed.' >&2; exit 127; }
        httperf_args=(--server "$host" --uri "$PATH_NAME" --rate "$rate" --num-conn "$requests" --num-call 1 --timeout 10)
        [[ -n $port ]] && httperf_args+=(--port "$port")
        httperf "${httperf_args[@]}"
        ;;
esac
