#!/usr/bin/env bash

# HTTP route checks and controlled load tests for authorized systems.
set -euo pipefail

DEFAULT_RATE=200      # Requests per second (hey uses one worker, so this is total rate)
DEFAULT_DURATION=30   # Seconds
MAX_RATE=500
MAX_DURATION=30
TOOL=""
PATH_NAME="/zeek-test"

usage() {
    cat >&2 <<'EOF'
Uso: curls IP[:PUERTO] [http|https] (-c|-y|-p) [opciones]

Herramientas:
  -c                 Prueba con curl rutas web comunes
  -y                 Prueba de carga controlada con hey
  -p                 Prueba de carga con httperf (solo HTTP)

Opciones para -y y -p:
  --path /RUTA       Endpoint de prueba (predeterminado: /zeek-test)
  --rate NUMERO      Solicitudes por segundo; maximo 500 (predeterminado: 200)
  --duration NUMERO  Duracion en segundos; maximo 30 (predeterminado: 30)
  --tool c|y|p       Forma compatible de seleccionar la herramienta
  -h, --help         Muestra esta ayuda

Ejemplos:
  ./curls 192.168.88.10 -c
  ./curls 192.168.88.10:8080 http -p
  ./curls 192.168.88.10 https -y --rate 75 --path /zeek-test
EOF
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

[[ $# -ge 1 ]] || { usage; exit 2; }

target=$1
shift
scheme="https"
rate=$DEFAULT_RATE
duration=$DEFAULT_DURATION

if [[ ${1:-} == "http" || ${1:-} == "https" ]]; then
    scheme=$1
    shift
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c) TOOL="c"; shift ;;
        -y) TOOL="y"; shift ;;
        -p) TOOL="p"; shift ;;
        --tool) TOOL=${2:-}; shift 2 ;;
        --path) PATH_NAME=${2:-}; shift 2 ;;
        --rate) rate=${2:-}; shift 2 ;;
        --duration) duration=${2:-}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Error: unknown option: %s\n' "$1" >&2; usage; exit 2 ;;
    esac
done

[[ $TOOL =~ ^(c|y|p)$ ]] || {
    echo 'Error: selecciona una herramienta con -c, -y o -p.' >&2
    usage
    exit 2
}
[[ $PATH_NAME == /* ]] || { echo 'Error: --path must start with /.' >&2; exit 2; }
[[ $rate =~ ^[0-9]+$ ]] && (( rate >= 1 && rate <= MAX_RATE )) || {
    printf 'Error: --rate must be between 1 and %s.\n' "$MAX_RATE" >&2; exit 2;
}
[[ $duration =~ ^[0-9]+$ ]] && (( duration >= 1 && duration <= MAX_DURATION )) || {
    printf 'Error: --duration must be between 1 and %s.\n' "$MAX_DURATION" >&2; exit 2;
}

if [[ $target =~ ^([0-9.]+)(:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[3]:-}
else
    echo 'Error: target must be an IPv4 address, optionally followed by :PORT.' >&2
    exit 2
fi

IFS=. read -r o1 o2 o3 o4 extra <<< "$host"
[[ -z ${extra:-} && -n ${o4:-} ]] || { echo 'Error: invalid IPv4 address.' >&2; exit 2; }
for octet in "$o1" "$o2" "$o3" "$o4"; do
    [[ $octet =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || {
        echo 'Error: invalid IPv4 address.' >&2; exit 2;
    }
done

if [[ -n $port ]] && { [[ ! $port =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); }; then
    echo 'Error: invalid port.' >&2
    exit 2
fi

base_url="${scheme}://${target}"

case "$TOOL" in
    c)
        command -v curl >/dev/null 2>&1 || {
            printf 'Error: curl no esta instalado.\n' >&2
            exit 127
        }
        paths=(
            "/wp-login.php"
            "/phpmyadmin/"
            "/admin.php"
            "/shell.php"
            "/.env"
            "/../../../../etc/passwd"
        )
        errors=0

        printf 'Destino: %s\n' "$base_url"
        printf 'Ejecuta estas pruebas solamente contra sistemas autorizados.\n\n'

        for path in "${paths[@]}"; do
            printf '%-30s ' "$path"
            if ! curl \
                --silent \
                --show-error \
                --insecure \
                --path-as-is \
                --connect-timeout 5 \
                --max-time 15 \
                --output /dev/null \
                --write-out 'HTTP %{http_code} | %{size_download} bytes | %{time_total}s\n' \
                "${base_url}${path}"; then
                errors=$((errors + 1))
            fi
        done

        if (( errors > 0 )); then
            printf '\n%s prueba(s) tuvieron errores de conexion.\n' "$errors" >&2
            exit 1
        fi
        ;;
    y)
        url="${base_url}${PATH_NAME}"
        requests=$(( rate * duration ))
        printf 'Target: %s\n' "$url"
        printf 'Controlled load: %s requests/sec for %ss (%s requests maximum)\n' "$rate" "$duration" "$requests"
        printf 'Run this only against systems you own or are explicitly authorized to test.\n\n'
        command -v hey >/dev/null 2>&1 || { echo 'Error: hey is not installed. Install it with: brew install hey' >&2; exit 127; }
        # One worker makes -q an overall rate limit, rather than a per-worker limit.
        hey -q "$rate" -c 1 -z "${duration}s" "$url"
        ;;
    p)
        url="${base_url}${PATH_NAME}"
        requests=$(( rate * duration ))
        printf 'Target: %s\n' "$url"
        printf 'Controlled load: %s requests/sec for %ss (%s requests maximum)\n' "$rate" "$duration" "$requests"
        printf 'Run this only against systems you own or are explicitly authorized to test.\n\n'
        [[ $scheme == "http" ]] || { echo 'Error: httperf mode supports HTTP only. Use curl or hey for HTTPS.' >&2; exit 2; }
        command -v httperf >/dev/null 2>&1 || { echo 'Error: httperf is not installed.' >&2; exit 127; }
        httperf_args=(--server "$host" --uri "$PATH_NAME" --rate "$rate" --num-conn "$requests" --num-call 1 --timeout 10)
        [[ -n $port ]] && httperf_args+=(--port "$port")
        httperf "${httperf_args[@]}"
        ;;
esac
