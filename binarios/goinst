#!/usr/bin/env bash
set -euo pipefail

language=es
bins=()
descriptions_es=()
descriptions_en=()
add_tool() {
    bins+=("$1")
    descriptions_es+=("$2")
    descriptions_en+=("$3")
}

# Preserve selection numbers for the existing tools.
add_tool locip 'Geolocaliza direcciones IP desde la terminal.' 'Look up IP geolocation from the command line.'
add_tool trafico 'Simula tráfico HTTP/HTTPS hacia un destino configurable.' 'Simulate HTTP/HTTPS traffic to a configurable target.'
add_tool traficoS 'Simula tráfico HTTPS hacia dominios predefinidos.' 'Simulate HTTPS traffic to predefined domains.'
add_tool sshc 'Ejecuta el mismo comando en varios hosts SSH.' 'Run the same command across multiple SSH hosts.'
add_tool vulnx 'Consulta los productos y versiones afectados por una CVE.' 'Look up products and versions affected by a CVE.'
add_tool ssh_fzf 'Selecciona hosts SSH con fzf y consulta su estado y diagnósticos de red.' 'Select SSH hosts with fzf and preview their status and network diagnostics.'
add_tool sitemirror 'Descarga un sitio web y crea una copia local con Colly.' 'Crawl a website with Colly and save a local copy.'
add_tool lanwatchgo 'Monitoriza la LAN con ping y ARP, historial JSON y panel web.' 'Monitor the LAN using ping and ARP, JSON history, and a web dashboard.'
add_tool mann 'Busca comandos de administración y red en un catálogo interactivo.' 'Search an interactive catalog of system administration and networking commands.'
add_tool autoteclado 'Simula tecleo y movimientos del ratón con pausas aleatorias.' 'Simulate typing and mouse movements with randomized delays.'
add_tool systemd-persist-audit 'Audita persistencia en systemd con puntuación de riesgo, JSON y modo interactivo.' 'Audit systemd persistence with risk scores, JSON output, and interactive browsing.'
add_tool backd 'Muestra procesos con conexiones de red activas.' 'Show processes with active network connections.'
add_tool chismes 'Monitoriza la red con tcpdump y tshark.' 'Monitor network traffic with tcpdump and tshark.'
add_tool dominf 'Inspecciona DNS, PTR, TLS, posibles IP de origen, AXFR y subdominios.' 'Inspect DNS, PTR, TLS, potential origin IPs, zone transfers, and subdomains.'
add_tool encriptar 'Cifra y descifra archivos .enc con contraseña o archivo de clave.' 'Encrypt and decrypt .enc files using a password or key file.'
add_tool grubprotect 'Guarda una copia base de GRUB, detecta cambios y la restaura en Linux.' 'Snapshot GRUB files, detect changes, and restore the baseline on Linux.'
add_tool honeypot 'Simula servicios de alta interacción con Beelzebub y sus módulos de IA.' 'Simulate high-interaction services with Beelzebub and its AI plugins.'
add_tool liveserver-html-hotreload 'Abre un HTML en Chromium y lo recarga cada vez que se guarda.' 'Open an HTML file in Chromium and reload it whenever it is saved.'
add_tool nmapx 'Gestiona escaneos de Nmap sobre un CIDR desde una TUI y genera un informe HTML.' 'Run Nmap scans across a CIDR from a terminal UI and generate an HTML report.'
add_tool receiver 'Guarda cada conexión TCP en un archivo numerado. Puerto por defecto 1235.' 'Save each TCP connection to a numbered file. Default port 1235.'
add_tool sandfly-processdecloak 'Detecta procesos ocultos por rootkits del kernel de Linux.' 'Detect processes hidden by Linux kernel rootkits.'
add_tool snifferip 'Captura ICMP con un socket raw y muestra protocolo, IP de origen y destino.' 'Capture ICMP with a raw socket and display the protocol and source and destination IPs.'
add_tool sshendless 'Retiene bots SSH enviando un banner sin fin.' 'Keep SSH bots connected by sending an endless banner.'
add_tool tun2socks 'Conecta una interfaz TUN a un proxy SOCKS o HTTP.' 'Route a TUN interface through a SOCKS or HTTP proxy.'
add_tool virus_total 'Consulta la reputación de IP en VirusTotal con curl y VT_API_KEY.' 'Check IP reputation on VirusTotal using curl and VT_API_KEY.'
add_tool voice-tool 'Convierte texto a MP3 con voces de OpenAI y perfiles integrados.' 'Convert text to MP3 using OpenAI voices and embedded profiles.'
add_tool zeektest 'Consulta eventos DNS de Zeek en Elasticsearch y muestra sus campos clave.' 'Query Zeek DNS events in Elasticsearch and display key fields.'

msg() {
    if [[ $language == es ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}

show_menu() {
    local i
    local -a descriptions
    if [[ $language == es ]]; then
        descriptions=("${descriptions_es[@]}")
    else
        descriptions=("${descriptions_en[@]}")
    fi
    printf '\n\033[1;35m%s\033[0m\n\n' "$(msg 'Instaladores disponibles' 'Available installers')"
    for i in "${!bins[@]}"; do
        printf ' %2d) \033[36m%s\033[0m — %s\n' "$((i + 1))" "${bins[i]}" "${descriptions[i]}"
    done
    printf ' %2d) %s\n\n' "$((${#bins[@]} + 1))" "$(msg 'Salir' 'Quit')"
    msg 'Elige un número y pulsa Enter (Shift+E para inglés): ' 'Choose a number and press Enter (Shift+E for Spanish): '
}

choose_tool() {
    local choice='' key quit=$((${#bins[@]} + 1))
    while :; do
        show_menu
        if [[ -t 0 ]]; then
            printf '%s' "$choice"
            while :; do
                IFS= read -rsn1 key || exit 1
                case $key in
                    ''|E) break ;;
                    $'\177'|$'\b')
                        if [[ -n $choice ]]; then
                            choice=${choice%?}
                            printf '\b \b'
                        fi ;;
                    *) choice+=$key; printf '%s' "$key" ;;
                esac
            done
        else
            key=''
            IFS= read -r choice || [[ -n $choice ]] || exit 1
            if [[ $choice == E ]]; then key=E; choice=''; fi
        fi
        printf '\n'
        if [[ $key != E ]]; then break; fi
        if [[ $language == es ]]; then language=en; else language=es; fi
        if [[ -t 1 ]]; then printf '\033[2J\033[H'; fi
    done
    if [[ ! $choice =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$(msg 'Selección inválida.' 'Invalid selection.')" >&2
        exit 1
    fi
    # Strip leading zeros before checking length and converting to a number.
    choice=${choice#"${choice%%[!0]*}"}
    if [[ -z $choice ]] || (( ${#choice} > ${#quit} || choice > quit )); then
        printf '%s\n' "$(msg 'Selección fuera de rango.' 'Selection out of range.')" >&2
        exit 1
    fi
    if (( choice == quit )); then exit 0; fi
    idx=$((choice - 1))
}

# Fetch just the selected project, including forks with upstream module names.
checkout_source() {
    local repo=$1 directory=$2 ref=$3
    git init -q "$work/source"
    cd "$work/source"
    git remote add origin "https://github.com/4rji/$repo.git"
    git fetch -q --depth=1 --filter=blob:none origin "$ref"
    if [[ $directory != . ]]; then
        git sparse-checkout set --no-cone "/$directory/"
    fi
    git checkout -q --detach FETCH_HEAD
    cd "$directory"
}

build_tool() {
    local repo=binarios-go directory=$bin ref=main target=.
    case $bin in
        locip|mann) go install "github.com/4rji/$bin@latest"; return ;;
        vulnx) go install github.com/projectdiscovery/cvemap/cmd/vulnx@latest; return ;;
        backd|chismes) repo=$bin; directory=.; ref=HEAD ;;
        trafico|traficoS) directory=trafico; target="./cmd/$bin" ;;
        nmapx) directory=nmap ;;
        ssh_fzf|grubprotect|zeektest) target="$bin.go" ;;
        snifferip) target=icmp.go ;;
        virus_total)
            # Last revision before the requested curl client was removed from main.
            ref=321f50d3be1576790a03d9c8c424bb63125fbcd2
            target=main3.go ;;
    esac
    checkout_source "$repo" "$directory" "$ref"
    if [[ $bin == backd && ! -f go.mod ]]; then
        go mod init github.com/4rji/backd
        go mod tidy
    fi
    if [[ $bin == tun2socks ]]; then
        # This fork's gVisor dependency needs Go 1.25 build constraints.
        CGO_ENABLED=0 GOTOOLCHAIN=go1.25.12 go build -o "$GOBIN/$bin" "$target"
    else
        go build -o "$GOBIN/$bin" "$target"
    fi
    if [[ $bin == systemd-persist-audit ]] && ! command -v fzf >/dev/null; then
        go install github.com/junegunn/fzf@latest
    fi
}

choose_tool
bin=${bins[idx]}
case $bin in
    grubprotect|sandfly-processdecloak)
        if [[ $(uname -s) != Linux ]]; then
            printf '%s\n' "$(msg 'Esta herramienta requiere Linux.' 'This tool requires Linux.')" >&2
            exit 1
        fi ;;
esac
printf '\n%s %s\n' "$(msg 'Instalando' 'Installing')" "$bin"
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export GOBIN="$work/bin"
export GOWORK=off
export GO111MODULE=on
mkdir -p "$GOBIN"
build_tool

if [[ ! -x $GOBIN/$bin ]]; then
    printf '%s %s\n' "$(msg 'Falta el ejecutable' 'Missing executable')" "$bin" >&2
    exit 1
fi

# Build unprivileged. Elevate only the final copy, as in the original installer.
as_root() {
    if (( EUID == 0 )); then "$@"; else sudo "$@"; fi
}

dest=/opt/4rji/bin
as_root mkdir -p "$dest"
if [[ $bin == honeypot ]]; then
    examples=/opt/4rji/share/honeypot/examples
    as_root mkdir -p "$examples/services"
    as_root install -m 644 configurations/beelzebub.yaml "$examples/"
    as_root install -m 644 configurations/services/*.yaml "$examples/services/"
fi
as_root install -m 755 "$GOBIN/"* "$dest/"
printf '%s %s/%s\n' "$(msg 'Instalado en' 'Installed to')" "$dest" "$bin"

case $bin in
    honeypot)
        printf '%s\n  %s\n' "$(msg 'Para usar la configuración de ejemplo:' 'To use the sample configuration:')" \
            "honeypot -confCore $examples/beelzebub.yaml -confServices $examples/services" ;;
    lanwatchgo) printf '%s\n' "$(msg 'Panel web local: lanwatchgo serve' 'Local web dashboard: lanwatchgo serve')" ;;
    ssh_fzf|chismes|nmapx)
        case $bin in
            ssh_fzf) deps=(fzf) ;;
            chismes) deps=(tcpdump tshark) ;;
            nmapx) deps=(nmap) ;;
        esac
        for dep in "${deps[@]}"; do
            if ! command -v "$dep" >/dev/null; then
                printf '%s %s\n' "$(msg 'Dependencia de ejecución pendiente:' 'Missing runtime dependency:')" "$dep"
            fi
        done ;;
esac
