#!/bin/bash

PROC="$1"

if [ -z "$PROC" ]; then
    echo "Usage: $0 <process_name>"
    exit 1
fi

echo "[*] Waiting for process: $PROC"

while true; do
    PID=$(pgrep -n -x "$PROC" 2>/dev/null)

    if [ -n "$PID" ]; then
        COMMAND=$(ps -ww -p "$PID" -o command= 2>/dev/null)
        OUT="process_${PROC}_$(date +%Y%m%d_%H%M%S).txt"

        {
            echo "=== PROCESS DETECTED ==="
            echo "Time: $(date)"
            printf 'Command: %s\n' "${COMMAND:-Unavailable (process exited before capture)}"
            echo

            printf '=== PROCESS: %s ===\n' "${COMMAND:-Unavailable (process exited before capture)}"
            ps -ww -p "$PID" -o pid,ppid,user,start,time,command

            echo
            printf '=== PARENT CHAIN: %s ===\n' "${COMMAND:-Unavailable (process exited before capture)}"

            CURRENT="$PID"

            while [ "$CURRENT" -gt 1 ] 2>/dev/null; do
                ps -ww -p "$CURRENT" -o pid,ppid,user,command

                CURRENT=$(ps -p "$CURRENT" -o ppid= 2>/dev/null | tr -d ' ')

                [ -z "$CURRENT" ] && break
            done

            echo
            echo "=== NETWORK CONNECTIONS ==="
            lsof -nP -a -p "$PID" -i 2>/dev/null

            echo
            echo "=== OPEN FILES ==="
            lsof -nP -p "$PID" 2>/dev/null

            echo
            echo "=== EXECUTABLE / CWD ==="
            lsof -p "$PID" 2>/dev/null | grep -E ' cwd | txt '

        } | tee "$OUT"

        echo
        echo "[+] Saved to: $OUT"
        exit 0
    fi

    sleep 0.1
done
