#!/usr/bin/env bash
set -euo pipefail

# Instala/desinstala GitHub Desktop (fork de shiftkey) en Debian/Ubuntu/Kali
# usando el repo apt del mirror mwt.me (se mantiene actualizado).
#
#   githubinst          instala
#   githubinst -u       desinstala (paquete + repo + clave)

usage() {
    echo "Uso: $(basename "$0") [-u|--uninstall] [-h|--help]"
    echo "  (sin flags)       instala GitHub Desktop"
    echo "  -u, --uninstall   desinstala GitHub Desktop y limpia el repo"
    exit "${1:-0}"
}

action="install"
case "${1:-}" in
    -u|--uninstall) action="uninstall" ;;
    -h|--help)      usage 0 ;;
    "")             ;;
    *)              echo -e "\033[1;31mOpcion invalida: $1\033[0m"; usage 1 ;;
esac

# Auto-eleva a root con sudo
if [ "$EUID" -ne 0 ]; then
    exec sudo bash "$(readlink -f "$0")" "$@"
fi

keyring="/etc/apt/keyrings/mwt-desktop.gpg"
srclist="/etc/apt/sources.list.d/mwt-desktop.list"

if [ "$action" = "uninstall" ]; then
    apt remove --purge -y github-desktop || true
    apt autoremove -y || true
    rm -f "$keyring" "$srclist"
    apt update || true
    echo -e "\033[1;32mGitHub Desktop desinstalado y repo limpiado.\033[0m"
    exit 0
fi

arch=$(dpkg --print-architecture)

# Dependencias
apt update
apt install -y wget gpg ca-certificates

# Clave GPG del repo
install -d -m 0755 /etc/apt/keyrings
wget -qO - https://mirror.mwt.me/shiftkey-desktop/gpgkey \
    | gpg --dearmor \
    | tee "$keyring" > /dev/null

# Lista de fuentes apt
echo "deb [arch=${arch} signed-by=${keyring}] https://mirror.mwt.me/shiftkey-desktop/deb/ any main" \
    > "$srclist"

# Instala GitHub Desktop
apt update
apt install -y github-desktop

echo -e "\033[1;32mGitHub Desktop instalado. Ejecutá:\033[0m github-desktop"
exit 0
