#!/usr/bin/env bash
set -euo pipefail

help() {
    cat <<'EOF'
Uso: cafe [opciones] [-- comando argumentos...]

Mantiene la computadora despierta hasta Ctrl+C o hasta terminar la tarea.
macOS: caffeinate -dimsu. Linux: systemd-inhibit (requiere systemd/logind).
En Linux bloquea suspension e inactividad, sin garantizar pantalla encendida.

  -h, --help          Muestra esta ayuda.
  -p, --process PROC  Espera un PID o nombre exacto de proceso existente.
                      Si hay varios con ese nombre, pedi un PID concreto.
  -t, --time SEG      Termina despues de SEG segundos (entero positivo).
                      Con -p, termina cuando finalice el proceso o el tiempo.
  -s, --system-only   En macOS permite apagar pantalla y discos (-is).
                      En Linux bloquea solo suspension, no inactividad.
  -n, --no-install    No instala dependencias faltantes.
  -q, --quiet         Omite mensajes informativos.
  -- comando ...     Mantiene despierta la maquina mientras corre el comando.
                      Conserva su codigo de salida; no combina con -p ni -t.

Ejemplos:
  cafe
  cafe -p 1234
  cafe -p ffmpeg
  cafe -t 3600
  cafe -s -p 1234 -t 7200
  cafe -- rsync -av origen/ destino/

En macOS busca tambien /usr/bin/caffeinate, incluido con el sistema.
En Linux instala systemd con apt-get, dnf, yum, pacman o zypper si falta
systemd-inhibit. La instalacion puede pedir sudo; el bloqueo usa tu usuario.
No cambia la configuracion permanente de energia ni evita cerrar la tapa.
EOF
}
die() { printf 'cafe: %s\n' "$*" >&2; exit 1; }
info() { if [[ $quiet == 0 ]]; then printf 'cafe: %s\n' "$*" >&2; fi; }
process='' duration=0 system_only=0 no_install=0 quiet=0
while (($#)); do
    case "$1" in
        -h|--help) help; exit 0 ;;
        -p|--process|-t|--time)
            (($# >= 2)) || die "Falta el valor para $1."
            if [[ $1 == -p || $1 == --process ]]; then
                [[ -n $2 ]] || die 'El proceso no puede estar vacio.'
                process=$2
            else
                [[ $2 =~ ^[1-9][0-9]*$ && ${#2} -le 9 ]] || die 'El tiempo debe ser un entero entre 1 y 999999999.'
                duration=$2
            fi
            shift 2 ;;
        -s|--system-only) system_only=1; shift ;;
        -n|--no-install) no_install=1; shift ;;
        -q|--quiet) quiet=1; shift ;;
        --) shift; (($#)) || die 'Falta el comando despues de --.'; break ;;
        *) die "Opcion desconocida: $1. Usa cafe -h." ;;
    esac
done
if (($#)) && [[ -n $process || $duration != 0 ]]; then
    die 'Usa -- comando sin -p ni -t.'
fi
pid=''
if [[ -n $process ]]; then
    if [[ $process =~ ^[0-9]+$ ]]; then
        [[ $process =~ ^[1-9][0-9]*$ ]] || die 'El PID debe ser positivo, sin ceros iniciales.'
        pid=$process
    else
        command -v pgrep >/dev/null 2>&1 || die 'Falta pgrep; usa -p con un PID.'
        matches=$(pgrep -x -- "$process" || true)
        [[ -n $matches ]] || die "No hay procesos con nombre exacto: $process."
        [[ $matches != *$'\n'* ]] || die "Hay varios procesos llamados $process. Usa -p PID."
        pid=$matches
    fi
    kill -0 "$pid" 2>/dev/null || die "El PID $pid no existe o no es accesible por tu usuario."
fi

case "$(uname -s)" in
    Darwin)
        backend=$(command -v caffeinate || true)
        [[ -n $backend ]] || backend=/usr/bin/caffeinate
        [[ -x $backend ]] || die 'Falta caffeinate, componente nativo de macOS; restaura /usr/bin/caffeinate desde macOS.'
        flags=(-dimsu)
        [[ $system_only == 0 ]] || flags=(-is)
        [[ -z $pid ]] || flags+=(-w "$pid")
        [[ $duration == 0 ]] || flags+=(-t "$duration")
        info 'Manteniendo macOS despierto. Ctrl+C para detener.'
        exec "$backend" "${flags[@]}" "$@"
        ;;
    Linux)
        [[ -d /run/systemd/system ]] || die 'Este Linux requiere systemd/logind activo para usar systemd-inhibit.'
        if ! command -v systemd-inhibit >/dev/null 2>&1; then
            [[ $no_install == 0 ]] || die 'Falta systemd-inhibit y --no-install esta activo.'
            elevate=()
            if ((EUID != 0)); then
                command -v sudo >/dev/null 2>&1 || die 'Falta sudo para instalar systemd.'
                elevate=(sudo)
            fi
            info 'Instalando systemd para obtener systemd-inhibit...'
            if command -v apt-get >/dev/null 2>&1; then
                "${elevate[@]}" apt-get update
                "${elevate[@]}" apt-get install -y systemd
            elif command -v dnf >/dev/null 2>&1; then
                "${elevate[@]}" dnf install -y systemd
            elif command -v yum >/dev/null 2>&1; then
                "${elevate[@]}" yum install -y systemd
            elif command -v pacman >/dev/null 2>&1; then
                "${elevate[@]}" pacman -S --needed --noconfirm systemd
            elif command -v zypper >/dev/null 2>&1; then
                "${elevate[@]}" zypper --non-interactive install systemd
            else
                die 'Instala systemd-inhibit con el gestor de paquetes de tu distribucion.'
            fi
            command -v systemd-inhibit >/dev/null 2>&1 || die 'La instalacion no dejo systemd-inhibit en PATH.'
        fi
        what=sleep:idle
        [[ $system_only == 0 ]] || what=sleep
        info 'Manteniendo Linux despierto. Ctrl+C para detener.'
        if (($#)); then
            exec systemd-inhibit --what="$what" --who=cafe --why='Tarea en curso' --mode=block -- "$@"
        fi
        # El monitor vive dentro del inhibidor: al salir libera el bloqueo.
        exec systemd-inhibit --what="$what" --who=cafe --why='Tarea en curso' --mode=block -- \
            bash -c '
                pid=$1; duration=$2; SECONDS=0
                trap "exit 130" INT
                trap "exit 143" TERM
                while :; do
                    if [[ -n $pid ]]; then
                        kill -0 "$pid" 2>/dev/null || exit 0
                        state=$(ps -o stat= -p "$pid" 2>/dev/null) || exit 0
                        [[ $state != *Z* ]] || exit 0
                    fi
                    ((duration == 0 || SECONDS < duration)) || exit 0
                    sleep 1
                done
            ' cafe-monitor "$pid" "$duration"
        ;;
    *) die 'Sistema no compatible; usa macOS o Linux.' ;;
esac
