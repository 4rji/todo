#!/usr/bin/env bash

BIN_DIR="/opt/4rji/bin"
BIN="$BIN_DIR/miniserver1"
FALLBACK_VERSION="0.29.0"
REPO_URL="https://github.com/svenstaro/miniserve"

miniserver1() {
    echo "cmd: miniserver1 $*"
    "$BIN" "$@"
}

# Detect OS + architecture and map to the release asset suffix
detect_target() {
    local os arch
    os="$(uname -s)"
    arch="$(uname -m)"

    case "$os" in
        Darwin)
            case "$arch" in
                arm64|aarch64) echo "aarch64-apple-darwin" ;;
                x86_64)        echo "x86_64-apple-darwin" ;;
                *) return 1 ;;
            esac
            ;;
        Linux)
            case "$arch" in
                x86_64|amd64)  echo "x86_64-unknown-linux-musl" ;;
                aarch64|arm64) echo "aarch64-unknown-linux-musl" ;;
                armv7l)        echo "armv7-unknown-linux-musleabihf" ;;
                armv6l)        echo "arm-unknown-linux-musleabihf" ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

# Latest release version (without the "v"), falls back to a pinned one
latest_version() {
    local ver=""
    if command -v curl >/dev/null 2>&1; then
        ver="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$REPO_URL/releases/latest" 2>/dev/null)"
        ver="${ver##*/v}"
    fi
    if [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ver"
    else
        echo "$FALLBACK_VERSION"
    fi
}

install_miniserve() {
    local target version url tmp sudo_cmd=""

    if ! target="$(detect_target)"; then
        echo -e "\033[1;31mUnsupported machine: $(uname -s) $(uname -m)\033[0m"
        echo "Download it manually from: $REPO_URL/releases"
        exit 1
    fi

    version="$(latest_version)"
    url="$REPO_URL/releases/download/v${version}/miniserve-${version}-${target}"
    tmp="$(mktemp)"

    echo -e "\033[1;34mMachine detected: $(uname -s) $(uname -m) -> $target\033[0m"
    echo "Downloading miniserve v$version:"
    echo "  $url"

    if command -v curl >/dev/null 2>&1; then
        curl -fL --progress-bar -o "$tmp" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --show-progress -O "$tmp" "$url"
    else
        echo -e "\033[1;31mNeither curl nor wget found.\033[0m"
        rm -f "$tmp"
        exit 1
    fi

    if [[ $? -ne 0 || ! -s "$tmp" ]]; then
        echo -e "\033[1;31mDownload failed.\033[0m"
        rm -f "$tmp"
        exit 1
    fi

    # sudo only needed here, to write into /opt/4rji/bin
    if [[ $EUID -ne 0 ]]; then
        sudo_cmd="sudo"
        echo -e "\033[1;33msudo is required to install into $BIN_DIR\033[0m"
    fi

    $sudo_cmd mkdir -p "$BIN_DIR" && $sudo_cmd install -m 755 "$tmp" "$BIN"
    local rc=$?
    rm -f "$tmp"

    if [[ $rc -ne 0 ]]; then
        echo -e "\033[1;31mInstall failed.\033[0m"
        exit 1
    fi

    if ! "$BIN" --version >/dev/null 2>&1; then
        echo -e "\033[1;31mInstalled binary does not run on this machine: $BIN\033[0m"
        exit 1
    fi

    echo -e "\033[1;32mInstalled: $("$BIN" --version) -> $BIN\033[0m"
}

# Already installed and runs on this machine -> use it as is, no sudo
if [[ ! -x "$BIN" ]]; then
    echo -e "\033[1;33mminiserve not found in $BIN_DIR\033[0m"
    install_miniserve
elif ! "$BIN" --version >/dev/null 2>&1; then
    echo -e "\033[1;33m$BIN exists but does not run on this machine (wrong OS/arch). Replacing it.\033[0m"
    install_miniserve
fi

# Arguments given -> pass them straight to miniserve, skip the menu
if [[ $# -gt 0 ]]; then
    miniserver1 "$@"
    exit $?
fi

echo ""
echo "Examples of usage:"
echo ""
echo "  miniserve ./ --port 9000"
echo "  miniserve ./ --upload-files"
echo "  miniserve ./ --upload-files --auth user:pass --port 80"
echo "  miniserve file1.txt file2.jpg"
echo ""
echo "  miniserve ./folder"
echo ""
echo "  miniserve ./ --tls-cert cert.pem --tls-key key.pem"
echo ""
echo "More versions:"
echo "  $REPO_URL/releases"
echo ""

#read -p "Press Enter to run miniserve (or type 'u' for upload, or a port number): " option
read -p $'Press Enter to run miniserve\nType "u" for upload\nOr enter a port number: ' option


if [[ -z "$option" ]]; then
    # No input: run default
    miniserver1 ./
elif [[ "$option" == "u" ]]; then
    # 'u' for upload option
    miniserver1 ./ --upload-files
elif [[ "$option" =~ ^[0-9]+$ ]]; then
    # Numeric input: set port
    miniserver1 ./ --port "$option"
else
    echo "Invalid option. Running default command."
    miniserver1 ./
fi
