#!/usr/bin/env bash
set -euo pipefail

QUIET=0
INTERACTIVE=1
USE_PAGER=auto # auto|always|never
COLOR_MODE=auto # auto|never

PAGER_CMD=()
SYSTEMD_DIRS=(
  /etc/systemd/system
  /run/systemd/system
  /usr/local/lib/systemd/system
  /usr/lib/systemd/system
  /lib/systemd/system
)

COLOR_OK=""
COLOR_REVIEW=""
COLOR_SUSPICIOUS=""
COLOR_HEADING=""
COLOR_RESET=""

usage() {
  cat <<EOF
CCDC Defensive Persistence Audit (systemd)
Usage: ${0##*/} [options]

Options:
  -q, --quiet           Salida reducida (resúmenes clave)
  -n, --no-interactive  No pausar entre secciones
  -p, --pager[=mode]    Paginado: auto (por defecto), always, never
      --no-color        Desactivar colores (también respeta NO_COLOR)
  -h, --help            Mostrar ayuda
EOF
}

setup_pager() {
  local tty=0
  if [ -t 1 ]; then tty=1; fi
  case "$USE_PAGER" in
    always)
      : ;;
    never)
      return 0 ;;
    auto)
      [ "$tty" -eq 1 ] || return 0 ;;
    *) : ;;
  esac
  if command -v less >/dev/null 2>&1; then
    PAGER_CMD=(less -RFSX)
  elif command -v more >/dev/null 2>&1; then
    PAGER_CMD=(more)
  fi
}

run_with_pager() {
  if [ "${#PAGER_CMD[@]}" -gt 0 ]; then
    "${PAGER_CMD[@]}"
  else
    cat
  fi
}

setup_colors() {
  if [ "$COLOR_MODE" = never ] || [ -n "${NO_COLOR+x}" ] || [ ! -t 1 ] || [ "${TERM:-}" = dumb ]; then
    return 0
  fi

  COLOR_OK=$'\033[1;32m'
  COLOR_REVIEW=$'\033[1;33m'
  COLOR_SUSPICIOUS=$'\033[1;31m'
  COLOR_HEADING=$'\033[1;36m'
  COLOR_RESET=$'\033[0m'
}

status_line() {
  local color="$1"
  local label="$2"
  shift 2
  printf '%b[%s]%b %s\n' "$color" "$label" "$COLOR_RESET" "$*"
}

ok() { status_line "$COLOR_OK" "OK" "$@"; }
review() { status_line "$COLOR_REVIEW" "REVISAR" "$@"; }
suspicious() { status_line "$COLOR_SUSPICIOUS" "SOSPECHOSO" "$@"; }

tag_block() {
  local level="$1"
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$level" in
      ok) ok "$line" ;;
      review) review "$line" ;;
      suspicious) suspicious "$line" ;;
    esac
  done
}

parse_args() {
  for arg in "$@"; do
    case "$arg" in
      -q|--quiet) QUIET=1 ;;
      -n|--no-interactive) INTERACTIVE=0 ;;
      -p|--pager) USE_PAGER=always ;;
      --pager=always) USE_PAGER=always ;;
      --pager=never) USE_PAGER=never ;;
      --pager=auto) USE_PAGER=auto ;;
      --no-color) COLOR_MODE=never ;;
      -h|--help) usage; exit 0 ;;
      *) echo "Opción no reconocida: $arg" >&2; usage; exit 2 ;;
    esac
  done
}

# CCDC Defensive Persistence Audit
# Focus: systemd services, timers and drop-ins.
# Runs read-only diagnostics and prints concise, greppable sections.

banner() { printf '\n%b==== %s ====%b\n' "$COLOR_HEADING" "$1" "$COLOR_RESET"; }
sub() { printf '\n%b-- %s --%b\n' "$COLOR_HEADING" "$1" "$COLOR_RESET"; }

pause_step() {
  [ "$INTERACTIVE" -eq 1 ] || return 0
  printf "\n[Enter para continuar, cualquier tecla también. Ctrl-C para salir] "
  if [ -t 0 ]; then
    IFS= read -r -s -n1 _key || true
  else
    sleep 0.2
  fi
  printf "\n"
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    review "Falta el comando requerido: $cmd" >&2
    return 1
  fi
}

print_expected() {
  review "Persistencia posible: Restart=, RemainAfterExit=, WantedBy= y timers habilitados."
  review "Revisá unidades locales, nombres inesperados y drop-ins que cambien el proveedor."
  suspicious "Priorizá Exec*= desde /tmp, /var/tmp, /dev/shm o directorios de usuarios."
  suspicious "Priorizá unidades modificables por todos o que ejecuten descargas/shells."
}

active_systemd_dirs() {
  local directory
  local previous
  local duplicate
  local -a unique_dirs
  unique_dirs=()

  for directory in "${SYSTEMD_DIRS[@]}"; do
    [ -d "$directory" ] || continue
    duplicate=0
    for previous in "${unique_dirs[@]}"; do
      if [ "$directory" -ef "$previous" ]; then
        duplicate=1
        break
      fi
    done
    [ "$duplicate" -eq 0 ] || continue
    unique_dirs[${#unique_dirs[@]}]="$directory"
    printf '%s\n' "$directory"
  done
}

search_unit_files() {
  local pattern="$1"
  local directory
  local -a directories
  directories=()

  while IFS= read -r directory; do
    directories[${#directories[@]}]="$directory"
  done < <(active_systemd_dirs)
  [ "${#directories[@]}" -gt 0 ] || return 0

  if command -v rg >/dev/null 2>&1; then
    rg -n --no-heading \
      --glob '*.service' --glob '*.timer' --glob '*.conf' \
      -e "$pattern" "${directories[@]}" 2>/dev/null || true
  else
    grep -RInE \
      --include='*.service' --include='*.timer' --include='*.conf' \
      "$pattern" "${directories[@]}" 2>/dev/null || true
  fi
}

show_pattern_results() {
  local level="$1"
  local found_message="$2"
  local empty_message="$3"
  local pattern="$4"
  local matches

  matches="$(search_unit_files "$pattern")"
  if [ -n "$matches" ]; then
    case "$level" in
      review) review "$found_message" ;;
      suspicious) suspicious "$found_message" ;;
    esac
    printf '%s\n' "$matches" | tag_block "$level"
  else
    ok "$empty_message"
  fi
}

list_enabled_unit_names() {
  local unit_type="$1"
  systemctl list-unit-files --type="$unit_type" --state=enabled \
    --no-legend --no-pager 2>/dev/null \
    | awk -v suffix=".$unit_type" '$1 ~ suffix "$" {print $1}' || true
}

audit_service_inventory() {
  banner "Servicios systemd"
  sub "systemctl list-units --type=service --all"
  if [ "$QUIET" -eq 1 ]; then
    systemctl list-units --type=service --all --no-legend --no-pager 2>/dev/null \
      | awk 'NF {print $1, $3, "|", substr($0, index($0,$5))}' || true
  else
    systemctl list-units --type=service --all --no-pager 2>/dev/null || true
  fi | run_with_pager || true
  pause_step
}

audit_unit_directories() {
  local directory

  banner "Archivos de unidades systemd"
  while IFS= read -r directory; do
    sub "$directory"
    if [ "$QUIET" -eq 1 ]; then
      ls -1 "$directory" 2>/dev/null || true
    else
      ls -la "$directory" 2>/dev/null || true
    fi
  done < <(active_systemd_dirs) | run_with_pager || true
  pause_step
}

audit_restart_directives() {
  banner "Directivas de reinicio y arranque"
  show_pattern_results \
    review \
    "Se encontraron directivas de reinicio o permanencia; validá que sean esperadas." \
    "No se encontraron directivas Restart=always/on-failure/on-abort ni RemainAfterExit=yes." \
    '^[[:space:]]*(Restart[[:space:]]*=[[:space:]]*(always|on-failure|on-abort)|RemainAfterExit[[:space:]]*=[[:space:]]*yes)'
  pause_step
}

audit_enabled_services() {
  local enabled
  local service

  banner "Servicios habilitados al arranque"
  sub "systemctl list-unit-files --type=service --state=enabled"
  if ! enabled="$(systemctl list-unit-files --type=service --state=enabled --no-pager 2>/dev/null)"; then
    review "No se pudo consultar la lista de servicios habilitados."
    pause_step
    return 0
  fi

  if [ -z "$enabled" ]; then
    ok "No hay servicios habilitados reportados por systemctl."
  elif [ "$QUIET" -eq 1 ]; then
    printf '%s\n' "$enabled" | awk 'NR==1 || $2=="enabled" {print $1, $2}' || true
  else
    printf '%s\n' "$enabled"
  fi | run_with_pager || true

  sub "Definiciones efectivas de servicios habilitados"
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    review "$service"
    if [ "$QUIET" -eq 1 ]; then
      systemctl cat "$service" --no-pager 2>/dev/null \
        | awk '/^[[:space:]]*(Exec(Start|StartPre|StartPost)|Restart|RestartSec|User|Group|EnvironmentFile)[[:space:]]*=/{print "    "$0}' || true
    else
      systemctl cat "$service" --no-pager 2>/dev/null | sed 's/^/    /' || true
    fi
  done < <(list_enabled_unit_names service) | run_with_pager || true
  pause_step
}

audit_timers() {
  local timers
  local enabled
  local timer
  local target

  banner "Timers systemd"
  sub "Timers activos, inactivos y próximos disparos"
  if ! timers="$(systemctl list-timers --all --no-pager 2>/dev/null)"; then
    review "No se pudo consultar systemctl list-timers."
  elif [ -n "$timers" ]; then
    printf '%s\n' "$timers" | run_with_pager || true
  else
    ok "systemctl no reportó timers."
  fi

  sub "Archivos timer habilitados"
  if ! enabled="$(systemctl list-unit-files --type=timer --state=enabled --no-pager 2>/dev/null)"; then
    review "No se pudo consultar la lista de timers habilitados."
  elif [ -z "$enabled" ]; then
    ok "No hay timers habilitados reportados por systemctl."
  elif [ "$QUIET" -eq 1 ]; then
    printf '%s\n' "$enabled" | awk 'NR==1 || $2=="enabled" {print $1, $2}' || true
  else
    printf '%s\n' "$enabled"
  fi | run_with_pager || true

  sub "Configuración y servicio disparado por cada timer habilitado"
  while IFS= read -r timer; do
    [ -n "$timer" ] || continue
    review "Timer habilitado: $timer"
    systemctl cat "$timer" --no-pager 2>/dev/null \
      | if [ "$QUIET" -eq 1 ]; then
          awk '/^[[:space:]]*(OnCalendar|OnBootSec|OnStartupSec|OnUnitActiveSec|OnUnitInactiveSec|Persistent|RandomizedDelaySec|AccuracySec|Unit)[[:space:]]*=/{print "    "$0}'
        else
          sed 's/^/    /'
        fi || true

    target="$(systemctl show "$timer" --property=Triggers --value 2>/dev/null | awk 'NF {print $1; exit}' || true)"
    [ -n "$target" ] || target="${timer%.timer}.service"
    review "Servicio disparado: $target"
    if [ "$QUIET" -eq 1 ]; then
      systemctl cat "$target" --no-pager 2>/dev/null \
        | awk '/^[[:space:]]*(Exec(Start|StartPre|StartPost)|User|Group|EnvironmentFile)[[:space:]]*=/{print "    "$0}' || true
    else
      systemctl cat "$target" --no-pager 2>/dev/null | sed 's/^/    /' || true
    fi
  done < <(list_enabled_unit_names timer) | run_with_pager || true
  pause_step
}

collect_timer_files() {
  local directory
  while IFS= read -r directory; do
    find "$directory" -xdev -type f -name '*.timer' -print 2>/dev/null || true
  done < <(active_systemd_dirs) | sort -u
}

audit_timer_files() {
  local timer_files
  local timer_file
  local target

  banner "Definiciones de timers instalados"
  timer_files="$(collect_timer_files)"
  if [ -z "$timer_files" ]; then
    review "No se encontraron archivos .timer legibles."
    pause_step
    return 0
  fi

  printf '%s\n' "$timer_files" | while IFS= read -r timer_file; do
    [ -n "$timer_file" ] || continue
    review "Timer instalado: $timer_file"
    if [ "$QUIET" -eq 1 ]; then
      awk '/^[[:space:]]*(OnCalendar|OnBootSec|OnStartupSec|OnUnitActiveSec|OnUnitInactiveSec|Persistent|RandomizedDelaySec|AccuracySec|Unit)[[:space:]]*=/{print "    "$0}' "$timer_file" 2>/dev/null || true
    else
      sed 's/^/    /' "$timer_file" 2>/dev/null || review "No se pudo leer $timer_file"
    fi

    target="$(awk -F= '/^[[:space:]]*Unit[[:space:]]*=/{value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value; exit}' "$timer_file" 2>/dev/null || true)"
    [ -n "$target" ] || target="$(basename "${timer_file%.timer}").service"
    review "Servicio asociado: $target"
  done | run_with_pager || true
  pause_step
}

collect_dropins() {
  local directory
  while IFS= read -r directory; do
    find "$directory" -xdev \( -type f -o -type l \) \
      -path '*.d/*.conf' -print 2>/dev/null || true
  done < <(active_systemd_dirs) | sort -u
}

audit_dropins() {
  local dropins
  local dropin
  local world_writable

  banner "Drop-ins y overrides"
  dropins="$(collect_dropins)"
  if [ -z "$dropins" ]; then
    ok "No se encontraron archivos *.d/*.conf en las rutas systemd revisadas."
  else
    printf '%s\n' "$dropins" | while IFS= read -r dropin; do
      [ -n "$dropin" ] || continue
      world_writable=""
      if [ ! -L "$dropin" ]; then
        world_writable="$(find "$dropin" -prune -perm -0002 -print 2>/dev/null || true)"
      fi
      if [ -n "$world_writable" ]; then
        suspicious "Drop-in modificable por todos: $dropin"
      else
        review "Drop-in: $dropin"
      fi

      if [ -L "$dropin" ]; then
        review "Enlace -> $(readlink "$dropin" 2>/dev/null || printf '?')"
      fi

      if [ "$QUIET" -eq 1 ]; then
        awk '/^[[:space:]]*(Exec|Restart|Environment|EnvironmentFile|User|Group|On|Unit|WantedBy|RequiredBy)/{print "    "$0}' "$dropin" 2>/dev/null || true
      else
        sed 's/^/    /' "$dropin" 2>/dev/null || review "No se pudo leer $dropin"
      fi
    done | run_with_pager || true
  fi

  if command -v systemd-delta >/dev/null 2>&1; then
    local deltas
    sub "Cambios efectivos detectados por systemd-delta"
    if ! deltas="$(SYSTEMD_PAGER=cat systemd-delta 2>/dev/null)"; then
      review "systemd-delta no pudo calcular las diferencias."
    elif [ -n "$deltas" ]; then
      printf '%s\n' "$deltas" | tag_block review | run_with_pager || true
    else
      ok "systemd-delta no reportó overrides, extensiones ni redirecciones."
    fi
  else
    review "systemd-delta no está disponible; se mostró el inventario directo de drop-ins."
  fi
  pause_step
}

audit_suspicious_directives() {
  banner "Indicadores de persistencia sospechosa"
  show_pattern_results \
    suspicious \
    "Unidades que ejecutan o cargan contenido desde ubicaciones temporales o de usuarios." \
    "No se detectaron rutas temporales o de usuarios en Exec*= o EnvironmentFile=." \
    '^[[:space:]]*(Exec(Start|StartPre|StartPost|Reload|Stop)|EnvironmentFile)[[:space:]]*=.*(/tmp/|/var/tmp/|/dev/shm/|/home/|/root/)'

  show_pattern_results \
    suspicious \
    "Unidades con descarga, conexión saliente o shell de comandos; revisá cada coincidencia." \
    "No se detectaron curl/wget/nc/socat ni shells con -c en directivas Exec*=." \
    '^[[:space:]]*Exec(Start|StartPre|StartPost)[[:space:]]*=.*((curl|wget|nc|ncat|socat)[[:space:]]|(/usr)?/bin/(ba)?sh[[:space:]]+-c)'
  pause_step
}

collect_unit_files() {
  local directory
  while IFS= read -r directory; do
    find "$directory" -xdev -type f \
      \( -name '*.service' -o -name '*.timer' -o -path '*.d/*.conf' \) \
      -print 2>/dev/null || true
  done < <(active_systemd_dirs) | sort -u
}

audit_unit_permissions() {
  local unit_files
  local world_writable
  local non_root_owned

  banner "Permisos y propietarios"
  unit_files="$(collect_unit_files)"
  if [ -z "$unit_files" ]; then
    review "No se encontraron archivos de unidades para revisar permisos."
    pause_step
    return 0
  fi

  world_writable="$(printf '%s\n' "$unit_files" | while IFS= read -r file; do
    find "$file" -prune -perm -0002 -print 2>/dev/null || true
  done)"
  if [ -n "$world_writable" ]; then
    suspicious "Archivos systemd modificables por todos:"
    printf '%s\n' "$world_writable" | tag_block suspicious
  else
    ok "Ningún archivo de unidad revisado es modificable por todos."
  fi

  non_root_owned="$(printf '%s\n' "$unit_files" | while IFS= read -r file; do
    find "$file" -prune ! -user root -print 2>/dev/null || true
  done)"
  if [ -n "$non_root_owned" ]; then
    suspicious "Archivos systemd que no pertenecen a root:"
    printf '%s\n' "$non_root_owned" | tag_block suspicious
  else
    ok "Todos los archivos de unidad revisados pertenecen a root."
  fi
  pause_step
}

main() {
  parse_args "$@"
  setup_colors
  setup_pager
  banner "CCDC Defensive Persistence Audit"
  print_expected
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    review "Ejecutalo con sudo para reducir falsos negativos por permisos de lectura."
  fi

  if require_cmd systemctl; then
    audit_service_inventory
    audit_enabled_services
    audit_timers
  else
    review "Se omiten los inventarios runtime; continúa la revisión de archivos accesibles."
  fi

  audit_unit_directories
  audit_timer_files
  audit_restart_directives
  audit_dropins
  audit_suspicious_directives
  audit_unit_permissions

  banner "Auditoría completada"
  ok "La recolección terminó sin modificar el sistema."
  review "Las coincidencias son indicadores de triage, no confirmación automática de persistencia."
}

main "$@"
