#!/usr/bin/env bash

set -u

INSTALL_DIR="/usr/local/bin"

# ─────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[0;37m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}[+]${NC} $1"; }
ok()    { echo -e "${GREEN}[✓]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; }

# Print to stderr so command substitutions and SBOM output stay clean.
show_command() {
    printf '+ ' >&2
    printf '%q ' "$@" >&2
    printf '\n' >&2
}

run_command() {
    show_command "$@"
    "$@"
}

# ─────────────────────────────────────────────
# OS / Architecture
# ─────────────────────────────────────────────

detect_platform() {
    OS="$(run_command uname -s)"
    ARCH="$(run_command uname -m)"

    case "$OS" in
        Darwin)
            PLATFORM="macOS"

            case "$ARCH" in
                arm64)
                    SNYK_BINARY="snyk-macos-arm64"
                    JQ_BINARY="jq-macos-arm64"
                    ;;
                *)
                    error "Unsupported macOS architecture: $ARCH"
                    exit 1
                    ;;
            esac
            ;;

        Linux)
            PLATFORM="Linux"

            case "$ARCH" in
                x86_64|amd64)
                    SNYK_BINARY="snyk-linux"
                    JQ_BINARY="jq-linux-amd64"
                    ;;
                *)
                    error "Unsupported Linux architecture: $ARCH"
                    exit 1
                    ;;
            esac
            ;;

        *)
            error "Unsupported OS: $OS"
            exit 1
            ;;
    esac

    ok "Detected: $PLATFORM / $ARCH"
}

# ─────────────────────────────────────────────
# SBOM filename: <project-folder>-<date>.json
# ─────────────────────────────────────────────

set_sbom_filename() {
    local project_name
    project_name="$(basename "$PWD")"
    SBOM_FILE="sbom-${project_name}-$(date +%Y%m%d).json"
    ok "SBOM file: $SBOM_FILE"
}

# ─────────────────────────────────────────────
# Requirements
# ─────────────────────────────────────────────

check_basic_tools() {
    if ! command -v curl >/dev/null 2>&1; then
        error "curl is required."
        exit 1
    fi
}

# ─────────────────────────────────────────────
# Install Snyk
# ─────────────────────────────────────────────

install_snyk() {
    info "Installing Snyk CLI..."

    TMP_DIR="$(run_command mktemp -d)"
    run_command cd "$TMP_DIR" || exit 1

    run_command curl -fsSLO \
        "https://downloads.snyk.io/cli/stable/${SNYK_BINARY}"

    run_command curl -fsSLO \
        "https://downloads.snyk.io/cli/stable/${SNYK_BINARY}.sha256"

    info "Verifying Snyk checksum..."

    if command -v sha256sum >/dev/null 2>&1; then
        run_command sha256sum -c "${SNYK_BINARY}.sha256"
    elif command -v shasum >/dev/null 2>&1; then
        run_command shasum -a 256 -c "${SNYK_BINARY}.sha256"
    else
        warn "No SHA256 utility found. Skipping checksum verification."
    fi

    run_command chmod +x "$SNYK_BINARY"

    run_command sudo mkdir -p "$INSTALL_DIR"
    run_command sudo mv "$SNYK_BINARY" "$INSTALL_DIR/snyk"

    run_command cd - >/dev/null || exit 1
    run_command rm -rf "$TMP_DIR"

    ok "Snyk installed."
}

# ─────────────────────────────────────────────
# Install Grype
# ─────────────────────────────────────────────

install_grype() {
    info "Installing Grype..."

    printf ' + curl -sSfL https://get.anchore.io/grype | sudo sh -s -- -b %q\n' "$INSTALL_DIR" >&2
    curl -sSfL https://get.anchore.io/grype |
        sudo sh -s -- -b "$INSTALL_DIR"

    ok "Grype installed."
}

# ─────────────────────────────────────────────
# Install Syft
# ─────────────────────────────────────────────

install_syft() {
    info "Installing Syft..."

    printf ' + curl -sSfL https://get.anchore.io/syft | sudo sh -s -- -b %q\n' "$INSTALL_DIR" >&2
    curl -sSfL https://get.anchore.io/syft |
        sudo sh -s -- -b "$INSTALL_DIR"

    ok "Syft installed."
}

# ─────────────────────────────────────────────
# Install jq
# ─────────────────────────────────────────────

install_jq() {
    info "Installing jq..."

    local base_url="https://github.com/jqlang/jq/releases/latest/download"
    local tmp_dir status

    tmp_dir="$(run_command mktemp -d)"

    # Subshell with set -e: any failed step (download, checksum) aborts the install.
    (
        set -e
        cd "$tmp_dir"

        run_command curl -fsSLO "${base_url}/${JQ_BINARY}"
        run_command curl -fsSLO "${base_url}/sha256sum.txt"

        info "Verifying jq checksum..."
        grep " ${JQ_BINARY}\$" sha256sum.txt > "${JQ_BINARY}.sha256"

        if command -v sha256sum >/dev/null 2>&1; then
            run_command sha256sum -c "${JQ_BINARY}.sha256"
        else
            run_command shasum -a 256 -c "${JQ_BINARY}.sha256"
        fi

        run_command sudo mkdir -p "$INSTALL_DIR"
        run_command sudo install -m 0755 "$JQ_BINARY" "$INSTALL_DIR/jq"
    )
    status=$?

    run_command rm -rf "$tmp_dir"

    if [ "$status" -ne 0 ]; then
        error "jq installation failed."
        return 1
    fi

    ok "jq installed."
}

# ─────────────────────────────────────────────
# Check / Install
# ─────────────────────────────────────────────

ensure_tools() {

    for tool in snyk grype syft jq; do

        if command -v "$tool" >/dev/null 2>&1; then
            ok "$tool found: $(command -v "$tool")"
            continue
        fi

        warn "$tool is not installed."

        read -r -p "Install $tool? [Y/n]: " answer
        answer="${answer:-Y}"

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            case "$tool" in
                snyk)
                    install_snyk
                    ;;
                grype)
                    install_grype
                    ;;
                syft)
                    install_syft
                    ;;
                jq)
                    install_jq
                    ;;
            esac
        else
            warn "$tool skipped."
        fi

    done
}

# ─────────────────────────────────────────────
# Scans
# ─────────────────────────────────────────────

run_snyk() {

    if ! command -v snyk >/dev/null 2>&1; then
        error "Snyk is not installed."
        return
    fi

    echo
    info "Running Snyk..."
    echo "────────────────────────────────────────"

    run_command snyk test

    echo
}

run_grype() {

    if ! command -v grype >/dev/null 2>&1; then
        error "Grype is not installed."
        return
    fi

    echo
    info "Running Grype filesystem scan..."
    echo "────────────────────────────────────────"

    run_command grype .

    echo
}

create_sbom() {

    if ! command -v syft >/dev/null 2>&1; then
        error "Syft is not installed."
        return 1
    fi

    echo
    info "Generating CycloneDX SBOM..."
    echo "────────────────────────────────────────"

    run_command syft . -o "cyclonedx-json=$SBOM_FILE"

    ok "SBOM created: $SBOM_FILE"
}

run_sbom_only() {
    create_sbom
    echo
}

run_sbom() {

    if ! command -v grype >/dev/null 2>&1; then
        error "Grype is not installed."
        return
    fi

    create_sbom || return

    echo
    info "Scanning SBOM with Grype..."
    echo "────────────────────────────────────────"

    run_command grype "sbom:$SBOM_FILE"

    echo
}

run_all() {

    echo
    info "Running complete vulnerability workflow"
    echo

    run_snyk
    run_grype
    run_sbom
}

# ─────────────────────────────────────────────
# Search SBOM components: cvesinst SBOM.json TERM
# ─────────────────────────────────────────────

search_sbom() (
    set -euo pipefail

    if ! command -v jq >/dev/null 2>&1; then
        error "jq is required. Run $0 without arguments to install it." >&2
        exit 1
    fi

    if ! command -v column >/dev/null 2>&1; then
        error "column is required." >&2
        exit 1
    fi

    if [ ! -r "$1" ]; then
        error "Cannot read file: $1" >&2
        exit 1
    fi

    jq -r --arg t "$2" '
      (.components // [])[]
      | select([.name,.purl,.description] | map(. // "") | join(" ") | ascii_downcase | contains($t | ascii_downcase))
      | [.name, (.version // "-"), (.purl // "-")] | @tsv' "$1" | column -t -s $'\t'
)

# ─────────────────────────────────────────────
# Menu
# ─────────────────────────────────────────────

menu() {

    while true; do

        echo
        echo -e "${CYAN}=========================================${NC}"
        echo -e "${BOLD}${CYAN} Vulnerability Scanner${NC}"
        echo -e "${CYAN}=========================================${NC}"
        echo
        echo -e "${MAGENTA}1) Snyk scan${NC}"
        echo -e "${BLUE}2) Grype filesystem scan${NC}"
        echo -e "${CYAN}3) Generate SBOM + scan with Grype${NC}"
        echo -e "${YELLOW}4) Generate SBOM only (sin Grype)${NC}"
        echo -e "${BOLD}5) Run ALL${NC}"
        echo -e "${WHITE}6) Show tool versions${NC}"
        echo -e "${RED}0) Exit${NC}"
        echo

        read -r -p "$(echo -e "${YELLOW}Select option: ${NC}")" choice

        case "$choice" in
            1)
                run_snyk
                ;;
            2)
                run_grype
                ;;
            3)
                run_sbom
                ;;
            4)
                run_sbom_only
                ;;
            5)
                run_all
                ;;
            6)
                echo
                command -v snyk >/dev/null && run_command snyk --version
                command -v grype >/dev/null && run_command grype version
                command -v syft >/dev/null && run_command syft version
                command -v jq >/dev/null && run_command jq --version
                ;;
            0)
                exit 0
                ;;
            *)
                error "Invalid option."
                ;;
        esac
    done
}

# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────

USAGE="Usage: $0 [SBOM.json TERM]"

if [ $# -eq 2 ]; then
    search_sbom "$1" "$2"
    exit $?
elif [ $# -ne 0 ]; then
    echo "$USAGE" >&2
    exit 2
fi

echo "$USAGE"
echo

detect_platform
check_basic_tools
ensure_tools
set_sbom_filename

echo
info "Scanning directory:"
run_command pwd

menu
