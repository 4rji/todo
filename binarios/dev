#!/usr/bin/env bash
# dev - run an x86_64 (amd64) Linux container from an Apple Silicon Mac.
#
# Model:
#   - The first run of each distro builds a local image (dev:debian,
#     dev:ubuntu) that adds zsh, sudo and the user "dev" (password "ass").
#     Every mode opens a zsh login shell as that user.
#   - One persistent container per distro (dev-debian, dev-ubuntu). No mount.
#     Install your tools there once; they are kept between runs.
#   - With -m, Docker cannot add a mount to an existing container, so the
#     script snapshots the persistent container, runs a throwaway copy of it
#     with the path mounted, and deletes the copy on exit.
#     Changes made inside that copy are NOT saved (files in the mounted path are).
set -euo pipefail

# ---------- colors (disabled when not a terminal) ----------
if [ -t 1 ]; then
  RED=$'\033[1;31m'; GRN=$'\033[1;32m'; YEL=$'\033[1;33m'
  BLU=$'\033[1;34m'; MAG=$'\033[1;35m'; CYN=$'\033[1;36m'
  DIM=$'\033[2m'; RST=$'\033[0m'
else
  RED=""; GRN=""; YEL=""; BLU=""; MAG=""; CYN=""; DIM=""; RST=""
fi

info() { printf '%s[*]%s %s\n' "$CYN" "$RST" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s[!]%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%s[x]%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# Banners in figlet's slant font, painted with a diagonal rainbow (lolcat style).
# One is picked at random on each run.
IFS= read -r -d '' BANNER_OPENGEAR <<'EOF' || true
   ____  ____  _______   _________________    ____
  / __ \/ __ \/ ____/ | / / ____/ ____/   |  / __ \
 / / / / /_/ / __/ /  |/ / / __/ __/ / /| | / /_/ /
/ /_/ / ____/ /___/ /|  / /_/ / /___/ ___ |/ _, _/
\____/_/   /_____/_/ |_/\____/_____/_/  |_/_/ |_|

EOF

IFS= read -r -d '' BANNER_DIGI <<'EOF' || true
    ____  ______________
   / __ \/  _/ ____/  _/
  / / / // // / __ / /
 / /_/ // // /_/ // /
/_____/___/\____/___/

EOF

banner() {
  local art
  if [ $((RANDOM % 2)) -eq 0 ]; then art="$BANNER_OPENGEAR"; else art="$BANNER_DIGI"; fi
  if [ -z "$RST" ]; then
    printf '%s\n' "$art"
    return
  fi
  local palette=(196 202 208 214 220 226 190 154 118 82 46 47 48 49 51 45 39 33 27 21 57 93 129 165 201 199 197)
  local n=${#palette[@]} row=0 line ch i
  while IFS= read -r line; do
    for ((i = 0; i < ${#line}; i++)); do
      ch="${line:i:1}"
      if [ "$ch" = " " ]; then
        printf ' '
      else
        printf '\033[1;38;5;%sm%s' "${palette[$(((i + row * 2) / 2 % n))]}" "$ch"
      fi
    done
    printf '%s\n' "$RST"
    row=$((row + 1))
  done <<<"$art"
}

usage() {
  banner
  cat <<EOF

${BLU}Usage:${RST} $(basename "$0") [debian|ubuntu] [-m /path] [--rm] [-h]

${BLU}Options:${RST}
  ${GRN}debian${RST}           Use Debian 12 (default)
  ${GRN}ubuntu${RST}           Use Ubuntu 22.04
  ${GRN}-m, --mount PATH${RST}  Mount PATH at /work in a ${RED}throwaway copy${RST} of the
                   persistent container (installed tools are available,
                   new changes are NOT saved)
  ${GRN}--rm${RST}             Ephemeral from a clean image: nothing is kept
  ${GRN}-l, --list${RST}       List persistent containers created by this script
  ${GRN}-h, --help${RST}       Show this help

${BLU}Behavior:${RST}
  (no arguments)            Debian, ${YEL}persistent${RST}, nothing mounted
  ubuntu                    Ubuntu, persistent, nothing mounted
  -m /path                  Copy of the persistent container + /path mounted,
                            ${RED}changes are not saved${RST}
  --rm                      Clean image, deleted on exit

${BLU}User:${RST}
  Every mode opens zsh as ${GRN}${DEV_USER}${RST} (password ${YEL}${DEV_PASS}${RST}, can sudo).
  The first run of each distro builds the local image dev:<distro>.

${BLU}Workflow:${RST}
  1. ${GRN}$(basename "$0")${RST}            install your tools (sudo apt, mise, ...) and exit
  2. ${GRN}$(basename "$0") -m ~/repo${RST}  work on a repo with those tools available

${DIM}Remove a persistent container with: docker rm dev-debian${RST}
EOF
  exit "${1:-0}"
}

# ---------- container user (baked into the image on its first build) ----------
DEV_USER="dev"
DEV_PASS="ass"

# ---------- argument parsing ----------
DISTRO="debian"
MOUNT=""
PERSIST=1

while [ $# -gt 0 ]; do
  case "$1" in
    debian|ubuntu) DISTRO="$1" ;;
    -m|--mount)
      [ $# -ge 2 ] || die "$1 needs a path"
      MOUNT="$2"; shift ;;
    --rm) PERSIST=0 ;;
    -l|--list)
      docker ps -a --filter "name=^dev-" \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
      exit 0 ;;
    -h|--help) usage 0 ;;
    *) warn "Unknown argument: $1"; usage 1 ;;
  esac
  shift
done

command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

case "$DISTRO" in
  debian) BASE_IMAGE="debian:12" ;;
  ubuntu) BASE_IMAGE="ubuntu:22.04" ;;
esac

NAME="dev-${DISTRO}"
IMAGE="dev:${DISTRO}"
# /dev/shm is a tmpfs (Docker default: 64MB). 8g is a ceiling, not a reservation:
# memory is only used as files are written.
SHM_SIZE="${DEV_SHM_SIZE:-8g}"
# docker run gets no command: the image's CMD opens the shell (zsh -l as DEV_USER).
RUN_ARGS=(--platform linux/amd64 --shm-size "$SHM_SIZE" -it)

if [ -n "$MOUNT" ]; then
  [ -d "$MOUNT" ] || die "Mount path does not exist: $MOUNT"
  MOUNT="$(cd "$MOUNT" && pwd)"
  if [ "$MOUNT" = "$HOME" ] || [ "$MOUNT" = "/" ]; then
    warn "Mounting ${MOUNT} exposes everything in it; rm -rf inside /work deletes real files."
  fi
  RUN_ARGS+=(-v "$MOUNT":/work -w /work)
fi

banner
info "Distro:  ${GRN}${DISTRO}${RST} (linux/amd64)"
info "User:    ${GRN}${DEV_USER}${RST} (zsh)"
info "Shm:     ${GRN}${SHM_SIZE}${RST} (/dev/shm, thin)"
if [ -n "$MOUNT" ]; then
  info "Mount:   ${GRN}${MOUNT}${RST} -> /work"
else
  info "Mount:   ${DIM}none${RST}"
fi

# ---------- local image: BASE_IMAGE + zsh, sudo and DEV_USER (built once) ----------
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  info "Building ${GRN}${IMAGE}${RST} from ${BASE_IMAGE} (first run only)"
  docker build --platform linux/amd64 -t "$IMAGE" - <<EOF
FROM ${BASE_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zsh sudo && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /usr/bin/zsh -G sudo ${DEV_USER} && echo '${DEV_USER}:${DEV_PASS}' | chpasswd
USER ${DEV_USER}
WORKDIR /home/${DEV_USER}
# Distro-recommended zshrc; any ~/.zshrc also skips the zsh-newuser-install wizard.
RUN cp /etc/zsh/newuser.zshrc.recommended .zshrc
CMD ["zsh", "-l"]
EOF
fi

# Containers created before this image existed have no DEV_USER and open as root.
if [ "$PERSIST" -eq 1 ] && docker container inspect "$NAME" >/dev/null 2>&1 &&
   [ "$(docker container inspect -f '{{.Config.User}}' "$NAME")" != "$DEV_USER" ]; then
  warn "${NAME} predates the '${DEV_USER}' user and still opens as root."
  warn "To switch, recreate it (its installed tools are lost): docker rm ${NAME}"
fi

# ---------- mounted run: throwaway copy of the persistent container ----------
if [ -n "$MOUNT" ]; then
  SNAP="dev:${DISTRO}-snap"
  if [ "$PERSIST" -eq 1 ] && docker container inspect "$NAME" >/dev/null 2>&1; then
    info "Snapshotting ${NAME} (your installed tools are kept)"
    docker commit "$NAME" "$SNAP" >/dev/null
    SRC="$SNAP"
  else
    SRC="$IMAGE"
    if [ "$PERSIST" -eq 1 ]; then
      warn "No persistent container '${NAME}' yet; using a clean ${IMAGE}."
      warn "Run '$(basename "$0") ${DISTRO}' without -m first to install your tools."
    fi
  fi
  printf '%s[!] WARNING: changes made inside this container will NOT be saved.%s\n' "$RED" "$RST"
  printf '%s[!] Install tools first without -m, then run with -m.%s\n' "$RED" "$RST"
  printf '%s[!] Only files inside %s are kept.%s\n' "$RED" "$MOUNT" "$RST"

  rc=0
  docker run --rm "${RUN_ARGS[@]}" "$SRC" || rc=$?
  docker rmi "$SNAP" >/dev/null 2>&1 || true
  exit "$rc"
fi

# ---------- ephemeral, no mount ----------
if [ "$PERSIST" -eq 0 ]; then
  info "Mode:    ${YEL}ephemeral${RST} (deleted on exit)"
  exec docker run --rm "${RUN_ARGS[@]}" "$IMAGE"
fi

# ---------- persistent, no mount ----------
info "Mode:    ${GRN}persistent${RST} (${NAME})"
if docker container inspect "$NAME" >/dev/null 2>&1; then
  ok "Reusing existing container"
  exec docker start -ai "$NAME"
fi

ok "Creating new container"
exec docker run --name "$NAME" "${RUN_ARGS[@]}" "$IMAGE"

